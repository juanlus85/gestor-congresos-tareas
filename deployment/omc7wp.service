[Unit]
Description=Gestor de congresos y tareas compartidas
After=network.target mysql.service

[Service]
Type=simple
User=omc7wp
Group=omc7wp
WorkingDirectory=/opt/gestor-congresos
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DATABASE_URL=mysql://gestor_app:CAMBIAR_POR_CLAVE_MUY_ROBUSTA@127.0.0.1:3306/gestor_congresos
Environment=JWT_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_DE_64_CARACTERES
Environment=INITIAL_ADMIN_NAME=Administrador inicial
Environment=INITIAL_ADMIN_EMAIL=admin@su-dominio.es
Environment=INITIAL_ADMIN_PASSWORD=CAMBIAR_POR_CLAVE_INICIAL_SEGURA
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
