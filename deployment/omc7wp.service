[Unit]
Description=Gestor de congresos y tareas compartidas
After=network.target mariadb.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=omc7wp
Group=omc7wp
WorkingDirectory=/opt/gestor-congresos
EnvironmentFile=/etc/gestor-congresos/gestor-congresos.env
ExecStart=/usr/bin/node /opt/gestor-congresos/dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/gestor-congresos/documents

[Install]
WantedBy=multi-user.target
