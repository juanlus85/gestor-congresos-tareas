# Archivo del sistema: /etc/gestor-congresos/gestor-congresos.env
# Propietario recomendado: root:omc7wp, modo 0640. No versionar ni enviar por correo.

NODE_ENV='production'
PORT='3000'
DOCUMENTS_DIRECTORY='/var/lib/gestor-congresos/documents'

# Genere los secretos en el VPS:
# openssl rand -hex 32
JWT_SECRET='REEMPLACE_POR_UN_SECRETO_DE_AL_MENOS_64_CARACTERES'

# Use letras y números exclusivamente. Genere uno con: openssl rand -hex 24
MYSQL_APP_PASSWORD='REEMPLACE_POR_LA_CLAVE_MYSQL'
DATABASE_URL='mysql://gestor_app:REEMPLACE_POR_LA_CLAVE_MYSQL@127.0.0.1:3306/gestor_congresos'

# Se crea sólo cuando la base de datos no contiene ya esa dirección de correo.
INITIAL_ADMIN_NAME='Administrador inicial'
INITIAL_ADMIN_EMAIL='admin@su-dominio.es'
INITIAL_ADMIN_PASSWORD='REEMPLACE_POR_UNA_CLAVE_INICIAL_DE_10_O_MAS_CARACTERES'
